# Example names only. APP_ORIGIN and GITHUB_CLIENT_ID are public configuration.
# Put GITHUB_CLIENT_SECRET and SESSION_SECRET only in Cloudflare Worker secrets.
APP_ORIGIN=https://YOUR-WORKER.workers.dev
GITHUB_CLIENT_ID=YOUR_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
